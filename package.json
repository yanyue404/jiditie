{
  "name": "squeeze-line-3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pages": "npm run build && wrangler pages dev dist --ip 0.0.0.0 --port 8788",
